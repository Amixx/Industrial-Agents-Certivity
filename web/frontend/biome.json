{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/build",
			"!**/.svelte-kit",
			"!**/node_modules",
			"!**/static",
			"!src/lib/api/fixtures"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": { "quoteStyle": "single" }
	},
	"css": {
		"parser": { "tailwindDirectives": true }
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": { "enabled": true }
	},
	"linter": {
		"enabled": true,
		"rules": {}
	},
	"overrides": [
		{
			"includes": ["src/routes/v/**"],
			"linter": { "rules": { "a11y": { "useSemanticElements": "off" } } }
		},
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"style": { "useConst": "off", "useImportType": "off" },
					"correctness": { "noUnusedImports": "off", "noUnusedVariables": "off" }
				}
			}
		}
	]
}

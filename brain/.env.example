# Copy to brain/.env (gitignored). A key alone never enables paid calls: BRAIN_LLM must name the provider.
BRAIN_LLM=anthropic            # anthropic, openai or local; leave unset for deterministic runs

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
BRAIN_MODEL=sonnet             # both tiers: opus, sonnet, fable, haiku or a model id
# BRAIN_MODEL_STRONG=opus      # overrides BRAIN_MODEL for profile, regulation review, relevance
# BRAIN_MODEL_BULK=sonnet      # overrides BRAIN_MODEL for the rewrite

# OpenAI
# OPENAI_API_KEY=your-openai-api-key

# Local OpenAI-compatible server
# BRAIN_LOCAL_URL=http://localhost:11434/v1
# BRAIN_LOCAL_MODEL=qwen3:14b

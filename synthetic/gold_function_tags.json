{
  "rules": {
    "ANY": "any light-signalling device, retro-reflectors included (UN R48 counts them as lamps)",
    "LAMP": "any light-emitting function (P, S or R)",
    "LED": "light-emitting function with LED modules / electronics",
    "MULTI": "two or more functions grouped, combined or reciprocally incorporated",
    "RED": "a red rear function (P, S or RR)",
    "P": "rear position lamp",
    "S": "stop lamp",
    "R": "reversing lamp",
    "RR": "rear retro-reflector",
    "P_AND_SR": "position lamp reciprocally incorporated with a function switched ON with it (S or R)",
    "P_AND_S": "position lamp reciprocally incorporated with a stop lamp",
    "S_OR_R": "stop or reversing lamp (functions that may not carry a logo)",
    "P_OR_S": "lamps other than reversing lamps (UN R148 Annex 8 1.2.2)",
    "P_OR_RR": "rear position lamp or rear retro-reflector (UN R48 5.18, movable components)"
  },
